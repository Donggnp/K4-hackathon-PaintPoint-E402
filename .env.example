OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ---- Lõi sinh mini-project -------------------------------------------------
OPENAI_MODEL=gpt-5.6-luna
# OPENAI_MODEL_REPO=
# OPENAI_MODEL_TUTORIAL=

# ---- Sandbox chạy test -----------------------------------------------------
# Mã do AI sinh LUÔN chạy trong Docker container cách ly.
VLEARN_RUN_TESTS=1
# VLEARN_DOCKER_IMAGE=vlearn-sandbox:1
# VLEARN_TEST_TIMEOUT=90
# VLEARN_SANDBOX_MEMORY=512m
# VLEARN_SANDBOX_CPUS=1.0

# Số vòng cho lõi tự sửa tới khi test xanh hết.
# VLEARN_MAX_FIX_ROUNDS=2
# VLEARN_PHASE_WORKERS=7        # số phase tutorial sinh song song
# VLEARN_REASONING_EFFORT=low   # 'none' để nhanh hơn, kém chính xác hơn

# NGUY HIỂM: chạy test trực tiếp trên máy thật khi không có Docker.
# Chỉ bật khi bạn hiểu rủi ro — mã do AI sinh sẽ chạy với quyền user của bạn.
# VLEARN_UNSAFE_HOST_TESTS=0

# ---- Khác ------------------------------------------------------------------
# VLEARN_PORT=3000
# OPENAI_HTTP_TIMEOUT_SECONDS=300

# Thư mục lưu lịch sử lượt chạy (mặc định codebase/runs).
# VLEARN_RUNS_DIR=
