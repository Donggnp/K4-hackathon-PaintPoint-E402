OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ---- Lõi sinh mini-project -------------------------------------------------
# Mặc định cho cả hai giai đoạn.
OPENAI_MODEL=gpt-4o-mini

# Ghi đè riêng từng giai đoạn (bỏ trống thì dùng OPENAI_MODEL ở trên):
#   repo     = sinh code, cần SUY LUẬN sâu, phải pass pytest thật -> đáng tiêu tiền
#   tutorial = viết văn xuôi, code đã được server ép đúng -> có thể dùng model rẻ hơn,
#              nhưng cần TRẦN OUTPUT LỚN (~15k token)
# OPENAI_MODEL_REPO=gpt-5
# OPENAI_MODEL_TUTORIAL=gpt-5-mini

# Chạy pytest thật trên repo do AI sinh (1 = bật, 0 = tắt).
VLEARN_RUN_TESTS=1
